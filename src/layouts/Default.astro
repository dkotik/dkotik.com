---
interface Props {
  title: string;
  description: string;
  keywords: string;
  class: string;
}

import Navigation from "./fragments/navigation.astro";
/* import HeadMeta from "./fragments/headmeta.astro" */
/* <HeadMeta
title={Astro.props.title}
description={Astro.props.description}
keywords={Astro.props.keywords}
/> */
import "./style.sass";
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <title>{Astro.props.title}</title>
    <link rel="canonical" href={ "https://dkotik.com"+Astro.url.pathname }>
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="title" content={Astro.props.title} />
    <meta name="description" content={Astro.props.description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content={Astro.props.keywords} />
    <meta property="og:image" content={ Astro.url.origin + "/img/og.jpg"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dima sitting on a park bench by a lake." />
    <meta property="fb:app_id" content="966242223397117" name="fb:app_id" />
    <meta
      property="og:description"
      content={Astro.props.description}
    />
    <meta property="og:url" content="https://dkotik.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={Astro.props.title} />
    <meta name="twitter:site" content="@dkotik">
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={Astro.props.title} />
    <meta name="twitter:description" content={Astro.props.description} />
    <meta name="twitter:image" content={ Astro.url.origin + "/img/og.jpg"} />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />
    <meta name="twitter:image:alt" content="Dima sitting on a park bench by a lake." />
  </head>
  <body class={Astro.props.class || "page"}>
    <slot name="hero">
      {
        Astro.props.class === "frontpage" ? (
          <div id="logo" />
        ) : (
          // <div style="float: right; margin: 0 1em 1em 1em;">
          // </div>
          ""
        )
      }
    </slot>
    <main class="container">
      <section class="content">
        <slot />
      </section>
    </main>
  </body>
</html>

<style>
  html {
    overscroll-behavior: none;
  }

  * {
    box-sizing: border-box;
  }
</style>
