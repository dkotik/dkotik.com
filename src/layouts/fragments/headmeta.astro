---
import { SEO } from "astro-seo"; // https://github.com/jonasmerlin/astro-seo

/* import { getImage } from "@astrojs/image";
const { src: cardImage } = await getImage({
    src: import("./share.png"),
    width: 225,
    height: 225,
    // aspectRatio: 16/9,
    format: "jpg"
}); */

const title = Astro.props.title
    ? "TO: " + Astro.props.title
    : "Truthonly.com";
---

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="content-type" content="text/html; charset=utf-8" />
<meta charset="utf-8">
<meta name="color-scheme" content="dark" />
<SEO
  title={ title }
  description={ Astro.props.description }
  openGraph={{
    basic: {
      image: "img/share.png",
      title: title,
      "type": "website"
    },
    image: {
      url: "/img/og.jpg",
      width: 1200,
      height: 630,
      alt: title
    }
  }}
  extend={{
    meta: [
      {
        name: "keywords",
        content: Astro.props.keywords?.join(", ")
      },
      {
        property: "og:description",
        content: Astro.props.description
      },
      {
        name: "twitter:image",
        content: "/assets/og.jpg"
      },
      {
        name: "twitter:title",
        content: title
      },
      {
        name: "twitter:description",
        content: Astro.props.description
      }
    ]
  }} />
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
